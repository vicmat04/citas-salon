generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String?
  role        String   // 'platform_admin' | 'salon_owner' | 'salon_staff'
  supabaseUid String?  @unique @map("supabase_uid")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ownedSalons         Salon[]
  salonMemberships    SalonMember[]
  createdAppointments Appointment[]
  accessTokens        AccessToken[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Salon {
  id                 String   @id @default(uuid())
  ownerId            String   @map("owner_id")
  name               String
  slug               String   @unique
  slogan             String?
  phone              String?
  email              String?
  address            String?
  logoUrl            String?  @map("logo_url")
  themeColor         String   @default("#D4AF37") @map("theme_color")
  countryCode        String   @default("PA") @map("country_code")
  phoneCountryCode   String   @default("+507") @map("phone_country_code")
  currency           String   @default("USD")
  timezone           String   @default("America/Panama")
  status             String   @default("pending") // 'pending', 'trial', 'active', 'suspended', 'cancelled'
  bookingRangeDays   Int      @default(15) @map("booking_range_days")
  minAdvanceHours    Int      @default(1) @map("min_advance_hours")
  notificationEmails String?  @map("notification_emails")
  planId             String?  @map("plan_id")
  adminNotes         String?  @map("admin_notes")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  owner         User           @relation(fields: [ownerId], references: [id])
  plan          Plan?          @relation(fields: [planId], references: [id])
  members       SalonMember[]
  categories    ServiceCategory[]
  services      Service[]
  specialists   Specialist[]
  specialistServices SpecialistService[]
  businessHours BusinessHours[]
  specialistHours SpecialistHours[]
  blockedDates  BlockedDate[]
  blockedSlots  BlockedSlot[]
  customers     Customer[]
  appointments  Appointment[]
  subscriptions Subscription[]
  accessTokens  AccessToken[]
  auditLogs     AuditLog[]

  @@index([status])
  @@index([ownerId])
  @@map("salons")
}

model SalonMember {
  id        String   @id @default(uuid())
  salonId   String   @map("salon_id")
  userId    String   @map("user_id")
  role      String   // 'owner' | 'manager' | 'receptionist' | 'specialist'
  createdAt DateTime @default(now()) @map("created_at")

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([salonId, userId])
  @@map("salon_members")
}

model ServiceCategory {
  id        String   @id @default(uuid())
  salonId   String   @map("salon_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services Service[]

  @@index([salonId])
  @@map("service_categories")
}

model Service {
  id              String   @id @default(uuid())
  salonId         String   @map("salon_id")
  categoryId      String?  @map("category_id")
  name            String
  description     String?
  price           Decimal  @default(0) @db.Decimal(10, 2)
  durationMinutes Int      @default(30) @map("duration_minutes")
  bufferMinutes   Int      @default(0) @map("buffer_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  salon               Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  category            ServiceCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  specialistServices  SpecialistService[]
  appointmentServices AppointmentService[]

  @@index([salonId])
  @@index([categoryId])
  @@map("services")
}

model Specialist {
  id        String   @id @default(uuid())
  salonId   String   @map("salon_id")
  name      String
  phone     String?
  email     String?
  specialty String?
  photoUrl  String?  @map("photo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  salon              Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  specialistServices SpecialistService[]
  specialistHours    SpecialistHours[]
  blockedDates       BlockedDate[]
  blockedSlots       BlockedSlot[]
  appointments       Appointment[]

  @@index([salonId])
  @@map("specialists")
}

model SpecialistService {
  id           String   @id @default(uuid())
  salonId      String   @map("salon_id")
  specialistId String   @map("specialist_id")
  serviceId    String   @map("service_id")
  createdAt    DateTime @default(now()) @map("created_at")

  salon      Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([specialistId, serviceId])
  @@map("specialist_services")
}

model BusinessHours {
  id         String   @id @default(uuid())
  salonId    String   @map("salon_id")
  dayOfWeek  Int      @map("day_of_week") // 0 to 6
  openTime   DateTime @db.Time() @map("open_time")
  closeTime  DateTime @db.Time() @map("close_time")
  isOpen     Boolean  @default(true) @map("is_open")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, dayOfWeek])
  @@map("business_hours")
}

model SpecialistHours {
  id           String   @id @default(uuid())
  salonId      String   @map("salon_id")
  specialistId String   @map("specialist_id")
  dayOfWeek    Int      @map("day_of_week") // 0 to 6
  openTime     DateTime @db.Time() @map("open_time")
  closeTime    DateTime @db.Time() @map("close_time")
  isAvailable  Boolean  @default(true) @map("is_available")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  salon      Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@unique([specialistId, dayOfWeek])
  @@map("specialist_hours")
}

model BlockedDate {
  id           String   @id @default(uuid())
  salonId      String   @map("salon_id")
  specialistId String?  @map("specialist_id") // null = bloquea salón completo
  date         DateTime @db.Date
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  salon      Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  specialist Specialist? @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@index([salonId, date])
  @@map("blocked_dates")
}

model BlockedSlot {
  id           String   @id @default(uuid())
  salonId      String   @map("salon_id")
  specialistId String?  @map("specialist_id") // null = bloquea salón completo
  date         DateTime @db.Date
  startTime    DateTime @db.Time() @map("start_time")
  endTime      DateTime @db.Time() @map("end_time")
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  salon      Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  specialist Specialist? @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@index([salonId, date])
  @@map("blocked_slots")
}

model Customer {
  id        String   @id @default(uuid())
  salonId   String   @map("salon_id")
  fullName  String   @map("full_name")
  phone     String
  email     String?
  notes     String?
  birthday  DateTime? @db.Date
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([salonId])
  @@index([salonId, phone])
  @@map("customers")
}

model Appointment {
  id                   String   @id @default(uuid())
  salonId              String   @map("salon_id")
  customerId           String?  @map("customer_id")
  specialistId         String?  @map("specialist_id")
  appointmentDate      DateTime @db.Date @map("appointment_date")
  startTime            DateTime @db.Time() @map("start_time")
  endTime              DateTime @db.Time() @map("end_time")
  status               String   @default("pending") // 'pending', 'confirmed', 'cancelled', 'completed', 'no_show', 'rescheduled'
  source               String   @default("public_form") // 'public_form', 'owner_panel', 'admin_panel'
  customerNotes        String?  @map("customer_notes")
  internalNotes        String?  @map("internal_notes")
  isSpecialEvent       Boolean  @default(false) @map("is_special_event")
  totalPriceSnapshot   Decimal  @default(0) @db.Decimal(10, 2) @map("total_price_snapshot")
  totalDurationMinutes Int      @default(0) @map("total_duration_minutes")
  createdByUserId      String?  @map("created_by_user_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  salon               Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  specialist          Specialist?          @relation(fields: [specialistId], references: [id], onDelete: SetNull)
  createdByUser       User?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  appointmentServices AppointmentService[]

  @@index([salonId, appointmentDate])
  @@index([specialistId, appointmentDate])
  @@index([salonId, status])
  @@index([customerId])
  @@map("appointments")
}

model AppointmentService {
  id               String   @id @default(uuid())
  appointmentId    String   @map("appointment_id")
  serviceId        String?  @map("service_id")
  priceSnapshot    Decimal  @db.Decimal(10, 2) @map("price_snapshot")
  durationSnapshot Int      @map("duration_snapshot")
  createdAt        DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@map("appointment_services")
}

model Plan {
  id                      String   @id @default(uuid())
  name                    String
  price                   Decimal  @default(0) @db.Decimal(10, 2)
  maxSpecialists          Int?     @map("max_specialists")
  maxAppointmentsPerMonth Int?     @map("max_appointments_per_month")
  hasReports              Boolean  @default(false) @map("has_reports")
  hasWhatsappAutomation   Boolean  @default(false) @map("has_whatsapp_automation")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")

  salons        Salon[]
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id        String   @id @default(uuid())
  salonId   String   @map("salon_id")
  planId    String   @map("plan_id")
  status    String   @default("trial") // 'trial', 'active', 'past_due', 'cancelled'
  startDate DateTime @db.Date @map("start_date")
  endDate   DateTime? @db.Date @map("end_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
  plan  Plan  @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model AccessToken {
  id        String    @id @default(uuid())
  salonId   String?   @map("salon_id")
  userId    String?   @map("user_id")
  tokenHash String    @unique @map("token_hash")
  purpose   String    // 'invitation', 'recovery', 'magic_link'
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  salon Salon? @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("access_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  salonId    String?  @map("salon_id")
  userId     String?  @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  salon Salon? @relation(fields: [salonId], references: [id], onDelete: SetNull)
  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([salonId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
